<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>TRẠNG THÁI HỆ THỐNG</string>
			<key>footerText</key>
			<string>Bật để thay thế luồng camera thật bằng media giả trên mọi ứng dụng hệ thống và bên thứ ba.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.weat.fakecamera</string>
			<key>key</key>
			<string>isEnabled</string>
			<key>label</key>
			<string>Bật Fake Camera</string>
			<key>PostNotification</key>
			<string>com.weat.fakecamera/prefsupdated</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
